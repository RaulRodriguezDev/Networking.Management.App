@{
    ViewData["Title"] = "Unauthorized";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var accessDenied = ViewData["AccessDenied"] as bool? ?? false;
    var loginError = TempData["LoginError"] as string;
    var autoOpenModal = loginError != null;
}

<section class="unauthorized">
    <div class="unauthorized__card">
        <svg class="unauthorized__icon" width="64" height="64" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0110 0v4" />
        </svg>

        @if (accessDenied)
        {
            <h2>Access Denied</h2>
            <p>Your account does not have permission to access the requested resource.</p>
        }
        else
        {
            <h2>Authentication Required</h2>
            <p>You need to sign in to access this resource.</p>
        }

        <button id="btn-open-login" class="unauthorized__btn" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2">
                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" />
                <polyline points="10 17 15 12 10 7" />
                <line x1="15" y1="12" x2="3" y2="12" />
            </svg>
            Sign In
        </button>
    </div>
</section>

<div id="login-overlay" class="login-overlay @(autoOpenModal ? "login-overlay--visible" : "")"
     role="dialog" aria-modal="true" aria-label="Sign in">
    <div class="login-modal">
        <div class="login-modal__header">
            <h3>Sign In</h3>
            <button id="btn-close-login" class="login-modal__close" type="button" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="login-modal__form">
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            @if (loginError != null)
            {
                <div class="login-modal__error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                    </svg>
                    <span>@loginError</span>
                </div>
            }

            <div class="login-modal__field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username"
                       placeholder="Enter username" required autofocus />
            </div>

            <div class="login-modal__field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password"
                       placeholder="Enter password" required />
            </div>

            <button type="submit" class="login-modal__submit">Sign In</button>

            <p class="login-modal__hint">
                Mock accounts: <code>admin / admin</code> or <code>guest / guest</code>
            </p>
        </form>
    </div>
</div>
