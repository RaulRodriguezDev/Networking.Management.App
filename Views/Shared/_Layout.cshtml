<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetMonitor</title>
    <link rel="stylesheet" href="/css/bundle.css" />
</head>
<body>
    <aside id="location-sidebar" class="sidebar">
        <div class="sidebar__header">
            <div class="sidebar__logo">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                </svg>
                <h1>NetMonitor</h1>
            </div>
            <p class="sidebar__subtitle">Hospital Network Management</p>
        </div>

        <div class="sidebar__search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <path d="M21 21l-4.35-4.35" />
            </svg>
            <input type="text" id="location-search" placeholder="Search locations…" />
        </div>

        <nav id="location-list" class="sidebar__nav" role="navigation" aria-label="Hospital locations"></nav>

        @if (User.IsInRole("Admin"))
        {
            <div class="sidebar__admin">
                <a asp-controller="Admin" asp-action="Index" class="sidebar__admin-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0
                                 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1
                                 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0
                                 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65
                                 1.65 0 004.68 15 1.65 1.65 0 003.17 14H3a2 2 0 010-4h.09A1.65
                                 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83
                                 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68 1.65 1.65 0 0010
                                 3.17V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0
                                 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65
                                 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1h.09a2 2 0 010
                                 4h-.09a1.65 1.65 0 00-1.51 1z" />
                    </svg>
                    <span>Administration</span>
                </a>
            </div>
        }

        <div class="sidebar__footer">
            <div class="sidebar__status-badge online"></div>
            <span>System Online</span>
        </div>
    </aside>

    <main id="main-content" class="main">
        <header class="topbar">
            <div class="topbar__left">
                <button id="btn-toggle-left" class="topbar__btn" title="Toggle locations">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18M3 6h18M3 18h18" />
                    </svg>
                </button>
                <h2 id="topbar-title">Select a location</h2>
            </div>
            <div class="topbar__right">
                <span id="equipment-count" class="badge">0 devices</span>
                <span id="online-count" class="badge badge--green">0 online</span>
                <span id="offline-count" class="badge badge--red">0 offline</span>
                <div class="topbar__separator"></div>
                <div class="topbar__user">
                    @if (User.Identity is { IsAuthenticated: true })
                    {
                        <svg class="topbar__user-icon" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span class="topbar__user-name">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="topbar__btn" title="Sign out">
                                <svg width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Unauthorized" class="topbar__user-link">
                            <svg width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span>Not signed in</span>
                        </a>
                    }
                </div>
            </div>
        </header>

        <div class="main__content">
            @RenderBody()
        </div>

        <footer class="footer">
            &copy; @DateTime.Now.Year - NetMonitor &middot;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </main>

    <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <script src="/js/bundle.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
