<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetMonitor</title>
    <script>
        (function(){
            try {
                var t = localStorage.getItem('theme');
                if (!t) {
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) t = 'theme-light';
                    else t = 'theme-dark';
                }
                document.documentElement.classList.add(t);
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="/css/bundle.css" />
</head>
<body>
    <aside id="location-sidebar" class="sidebar">
        <div class="sidebar__header">
            <div class="sidebar__logo">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                </svg>
                <h1>NetMonitor</h1>
            </div>
            <p class="sidebar__subtitle">Hospital Network Management</p>
        </div>

        <div class="sidebar__search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <path d="M21 21l-4.35-4.35" />
            </svg>
            <input type="text" id="location-search" placeholder="Search locations…" />
        </div>

        <nav id="location-list" class="sidebar__nav" role="navigation" aria-label="Hospital locations"></nav>

        @if (User.IsInRole("Admin") || User.IsInRole("IT"))
        {
            <div class="sidebar__admin">
                <a asp-controller="Admin" asp-action="Index" class="sidebar__admin-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0
                                 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1
                                 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0
                                 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65
                                 1.65 0 004.68 15 1.65 1.65 0 003.17 14H3a2 2 0 010-4h.09A1.65
                                 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83
                                 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68 1.65 1.65 0 0010
                                 3.17V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0
                                 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65
                                 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1h.09a2 2 0 010
                                 4h-.09a1.65 1.65 0 00-1.51 1z" />
                    </svg>
                    <span>Administration</span>
                </a>
            </div>
        }

        <div class="sidebar__footer">
            <div class="sidebar__status-badge online"></div>
            <span>System Online</span>
        </div>
    </aside>

    <main id="main-content" class="main">
        <header class="topbar">
            <div class="topbar__left">
                <button id="btn-toggle-left" class="topbar__btn" title="Toggle locations">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18M3 6h18M3 18h18" />
                    </svg>
                </button>
                <h2 id="topbar-title">Select a location</h2>
            </div>
            <div class="topbar__right">
                <button id="theme-toggle" class="topbar__btn topbar__theme-btn" title="Toggle theme" aria-pressed="false" aria-label="Toggle light/dark mode">
                    <!-- icon set by script -->
                </button>
                <script>
                    (function(){
                        try {
                            var btn = document.getElementById('theme-toggle');
                            if (!btn) return;
                            function isLight(){ return document.documentElement.classList.contains('theme-light'); }
                            function update(){
                                var light = isLight();
                                btn.setAttribute('aria-pressed', light? 'true':'false');
                                btn.innerHTML = light
                                    ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>'
                                    : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>';
                            }
                            btn.addEventListener('click', function(){
                                var light = !document.documentElement.classList.contains('theme-light');
                                if (light){ document.documentElement.classList.add('theme-light'); document.documentElement.classList.remove('theme-dark'); localStorage.setItem('theme','theme-light'); }
                                else { document.documentElement.classList.remove('theme-light'); document.documentElement.classList.add('theme-dark'); localStorage.setItem('theme','theme-dark'); }
                                update();
                                // force reload CSS to ensure styles apply (helps with some caching scenarios)
                                try{ var links = document.querySelectorAll('link[rel=stylesheet]'); links.forEach(function(l){ var href = l.getAttribute('href'); if (href){ l.setAttribute('href', href.split('?')[0] + '?v=' + Date.now()); }}); }catch(e){}
                            });
                            update();
                        }catch(e){ }
                    })();
                </script>
                <span id="equipment-count" class="badge">0 devices</span>
                <span id="online-count" class="badge badge--green">0 online</span>
                <span id="offline-count" class="badge badge--red">0 offline</span>
                @if (User.IsInRole("Admin") || User.IsInRole("IT"))
                {
                    <div class="topbar__notify" id="notify-root">
                        <button type="button" class="topbar__btn topbar__notify-btn" id="notify-btn"
                                title="Network alerts" aria-label="Network alerts">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">
                                <path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                                <path d="M13.73 21a2 2 0 01-3.46 0" />
                            </svg>
                            <span class="topbar__notify-badge" id="notify-badge" hidden>0</span>
                        </button>
                        <div class="topbar__notify-backdrop" id="notify-backdrop"></div>
                        <div class="topbar__notify-panel" id="notify-panel">
                            <div class="topbar__notify-header">
                                <span>Notifications</span>
                                <div class="topbar__notify-actions">
                                    <button type="button" class="topbar__notify-clear" id="notify-clear" hidden>Dismiss all</button>
                                    <button type="button" class="topbar__notify-close" id="notify-close" title="Close" aria-label="Close">&times;</button>
                                </div>
                            </div>
                            <div class="topbar__notify-section" id="notify-status-section" hidden>
                                <div class="topbar__notify-subheader">Device status changes</div>
                                <div class="topbar__notify-list" id="notify-status-list"></div>
                            </div>
                            <div class="topbar__notify-section">
                                <div class="topbar__notify-subheader">Unregistered devices on the network</div>
                                <div class="topbar__notify-list" id="notify-list"></div>
                            </div>
                            <a class="topbar__notify-footer" asp-controller="Admin" asp-action="Devices">Manage in Devices</a>
                        </div>
                    </div>
                }
                <div class="topbar__separator"></div>
                <div class="topbar__user">
                    @if (User.Identity is { IsAuthenticated: true })
                    {
                        <svg class="topbar__user-icon" width="18" height="18" viewBox="0 0 24 24"
                             fill="currentColor">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                        </svg>
                        <span class="topbar__user-name">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="topbar__btn" title="Sign out">
                                <svg width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Unauthorized" asp-route-login="1" class="topbar__user-link">
                            <svg width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span>Not signed in</span>
                        </a>
                    }
                </div>
            </div>
        </header>

        <div class="main__content">
            @RenderBody()
        </div>

        <footer class="footer">
            &copy; @DateTime.Now.Year - NetMonitor &middot;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </main>

    <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <script src="/js/bundle.js"></script>
    <script src="/js/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
