@{
    ViewData["Title"] = "Administration";
}

<section class="admin">
    <div class="admin__header">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33
                     1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0
                     01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15 1.65 1.65 0 003.17 14H3a2 2 0 010-4h.09A1.65
                     1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0
                     009 4.68 1.65 1.65 0 0010 3.17V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2
                     2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1h.09a2 2 0 010
                     4h-.09a1.65 1.65 0 00-1.51 1z" />
        </svg>
        <div>
            <h2>Administration Panel</h2>
            <p>Manage system settings, users, and network configuration.</p>
        </div>
    </div>

    <div class="admin__grid">
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Users" class="admin__card admin__card--link admin__card--users">
                <span class="admin__card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 00-3-3.87" />
                        <path d="M16 3.13a4 4 0 010 7.75" />
                    </svg>
                </span>
                <h3>User Management</h3>
                <p>Add, edit, or remove user accounts and assign roles.</p>
            </a>
        }

        <a asp-controller="Admin" asp-action="Devices" class="admin__card admin__card--link admin__card--devices">
            <span class="admin__card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                    <line x1="6" y1="6" x2="6.01" y2="6" />
                    <line x1="6" y1="18" x2="6.01" y2="18" />
                </svg>
            </span>
            <h3>Network Devices</h3>
            <p>Register new devices, update configurations, and remove decommissioned equipment.</p>
        </a>

        <a asp-controller="Admin" asp-action="Locations" class="admin__card admin__card--link admin__card--locations">
            <span class="admin__card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
            </span>
            <h3>Locations</h3>
            <p>Manage hospital departments, floors, and network zones.</p>
        </a>

        <a asp-controller="Admin" asp-action="Reports" class="admin__card admin__card--link admin__card--reports">
            <span class="admin__card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M12 20V10" />
                    <path d="M18 20V4" />
                    <path d="M6 20v-4" />
                </svg>
            </span>
            <h3>Reports</h3>
            <p>View uptime reports, device health history, and network analytics.</p>
        </a>

        <a asp-controller="Admin" asp-action="Logs" class="admin__card admin__card--link admin__card--logs">
            <span class="admin__card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                    <path d="M14 2v6h6" />
                    <path d="M16 13H8M16 17H8M10 9H8" />
                </svg>
            </span>
            <h3>Activity Logs</h3>
            <p>Review application, authentication, and device activity logs.</p>
        </a>
    </div>
</section>


