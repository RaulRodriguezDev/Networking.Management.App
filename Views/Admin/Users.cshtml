@{
    ViewData["Title"] = "User Management";
}

<section class="users" id="users-page">
    <div class="users__header">
        <div class="users__header-info">
            <a asp-controller="Admin" asp-action="Index" class="users__back" title="Back to Administration">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5" />
                    <path d="M12 19l-7-7 7-7" />
                </svg>
            </a>
            <div>
                <h2>User Management</h2>
                <p>Add, edit, or remove user accounts and assign roles.</p>
            </div>
        </div>
        <button type="button" class="btn btn--primary" id="btn-add-user">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
            </svg>
            <span>Add User</span>
        </button>
    </div>

    <div class="users__table-wrap">
        <table class="users__table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th class="users__table-actions">Actions</th>
                </tr>
            </thead>
            <tbody id="users-tbody">
                <tr><td colspan="4" class="ui-state__cell">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <div class="pagination" id="users-pagination"></div>
</section>

<!-- ===== Add / Edit Modal ===== -->
<div class="modal" id="user-modal" aria-hidden="true">
    <div class="modal__backdrop" data-close-modal></div>
    <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="user-modal-title">
        <div class="modal__header">
            <h3 id="user-modal-title">Add User</h3>
            <button type="button" class="modal__close" data-close-modal aria-label="Close">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="user-form" class="modal__body">
            <input type="hidden" id="user-id" />

            <div class="form-group">
                <label for="user-name">Full Name</label>
                <input type="text" id="user-name" required maxlength="100" placeholder="e.g. Jane Doe" />
            </div>

            <div class="form-group">
                <label for="user-username">Username</label>
                <input type="text" id="user-username" required maxlength="50" placeholder="e.g. jane_doe" />
                <small class="form-hint" id="username-hint">Must be unique. Lowercase recommended.</small>
            </div>

            <div class="form-group">
                <label for="user-password">Password</label>
                <input type="password" id="user-password" minlength="8" placeholder="Minimum 8 characters" />
                <small class="form-hint" id="password-hint">Minimum 8 characters.</small>
            </div>

            <div class="form-group">
                <label>Role</label>
                <div class="role-cards" id="role-cards">
                    <!-- role cards injected by JS -->
                </div>
                <input type="hidden" id="user-role-id" />
            </div>
        </form>

        <div class="modal__footer">
            <button type="button" class="btn btn--ghost" data-close-modal>Cancel</button>
            <button type="button" class="btn btn--primary" id="btn-save-user">Save</button>
        </div>
    </div>
</div>

<!-- ===== Delete Confirmation Modal ===== -->
<div class="modal" id="delete-modal" aria-hidden="true">
    <div class="modal__backdrop" data-close-modal></div>
    <div class="modal__dialog modal__dialog--sm" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
        <div class="modal__header">
            <h3 id="delete-modal-title">Delete User</h3>
            <button type="button" class="modal__close" data-close-modal aria-label="Close">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="modal__body">
            <p class="delete-warning">
                Are you sure you want to delete <strong id="delete-username"></strong>?
                This action cannot be undone.
            </p>
        </div>
        <div class="modal__footer">
            <button type="button" class="btn btn--ghost" data-close-modal>Cancel</button>
            <button type="button" class="btn btn--danger" id="btn-confirm-delete">Delete</button>
        </div>
    </div>
</div>



