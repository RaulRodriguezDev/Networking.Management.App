@{
    ViewData["Title"] = "Location Management";
}

<section class="locations" id="locations-page">
    <div class="locations__header">
        <div class="locations__header-info">
            <a asp-controller="Admin" asp-action="Index" class="locations__back" title="Back to Administration">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5" />
                    <path d="M12 19l-7-7 7-7" />
                </svg>
            </a>
            <div>
                <h2>Location Management</h2>
                <p>Add, edit, or remove hospital departments, floors, and network zones.</p>
            </div>
        </div>
        <button type="button" class="btn btn--primary" id="btn-add-location">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
            </svg>
            <span>Add Location</span>
        </button>
    </div>

    <div class="locations__table-wrap">
        <table class="locations__table">
            <thead>
                <tr>
                    <th>Location</th>
                    <th>Floor</th>
                    <th>Devices</th>
                    <th>Status</th>
                    <th class="locations__table-actions">Actions</th>
                </tr>
            </thead>
            <tbody id="locations-tbody">
                <tr><td colspan="5" class="ui-state__cell">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <div class="pagination" id="locations-pagination"></div>
</section>

<!-- ===== Add / Edit Modal ===== -->
<div class="modal" id="location-modal" aria-hidden="true">
    <div class="modal__backdrop" data-close-modal></div>
    <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="location-modal-title">
        <div class="modal__header">
            <h3 id="location-modal-title">Add Location</h3>
            <button type="button" class="modal__close" data-close-modal aria-label="Close">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="location-form" class="modal__body">
            <input type="hidden" id="location-id" />

            <div class="form-group">
                <label for="location-name">Location Name</label>
                <input type="text" id="location-name" required maxlength="100" placeholder="e.g. Emergency Room" />
                <small class="form-hint">Must be unique.</small>
            </div>

            <div class="form-group">
                <label for="location-floor">Floor</label>
                <input type="text" id="location-floor" required maxlength="50" placeholder="e.g. Ground Floor" />
            </div>
        </form>

        <div class="modal__footer">
            <button type="button" class="btn btn--ghost" data-close-modal>Cancel</button>
            <button type="button" class="btn btn--primary" id="btn-save-location">Save</button>
        </div>
    </div>
</div>

<!-- ===== Delete Confirmation Modal ===== -->
<div class="modal" id="delete-modal" aria-hidden="true">
    <div class="modal__backdrop" data-close-modal></div>
    <div class="modal__dialog modal__dialog--sm" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
        <div class="modal__header">
            <h3 id="delete-modal-title">Delete Location</h3>
            <button type="button" class="modal__close" data-close-modal aria-label="Close">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="modal__body">
            <p class="delete-warning">
                Are you sure you want to delete <strong id="delete-location-name"></strong>?
                This action cannot be undone.
            </p>
        </div>
        <div class="modal__footer">
            <button type="button" class="btn btn--ghost" data-close-modal>Cancel</button>
            <button type="button" class="btn btn--danger" id="btn-confirm-delete">Delete</button>
        </div>
    </div>
</div>
